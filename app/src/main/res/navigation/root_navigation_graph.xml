<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_navigation_graph"
    app:startDestination="@id/detailsFragment">

    <fragment
        android:id="@+id/audioplayerFragment"
        android:name="com.example.mynewplaylist.player.ui.AudioplayerFragment"
        android:label="fragment_audio_player"
        tools:layout="@layout/fragment_audio_player" />
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.mynewplaylist.search.ui.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_searchFragment_to_audioplayerFragment"
            app:destination="@id/audioplayerFragment" />
    </fragment>
    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.mynewplaylist.media.ui.DetailsFragment"
        android:label="fragment_media"
        tools:layout="@layout/fragment_media" />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.mynewplaylist.settings.ui.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.example.mynewplaylist.media.ui.PlaylistFragment"
        android:label="playlist_fragment"
        tools:layout="@layout/playlist_fragment" />
    <fragment
        android:id="@+id/tracksFragment"
        android:name="com.example.mynewplaylist.media.ui.TracksFragment"
        android:label="track_fragment"
        tools:layout="@layout/track_fragment" />
</navigation>