<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/Theme.MyNewPlaylist">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryVariant">
            <Button
                android:id="@+id/menu_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:icon="@drawable/back"
                android:background="@android:color/transparent"
                app:iconSize="48sp"

                app:iconTint="?attr/colorSecondary"
                />
            <ImageView
                android:id="@+id/cover"
                android:background="@drawable/radius_cover"
                android:layout_width="312dp"
                android:layout_height="312dp"
                android:layout_marginTop="82dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/vector3"
                app:layout_constraintBottom_toTopOf="@id/track_name_for_audio"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.407"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:fontFamily="@font/ys_display_medium"
                android:id="@+id/track_name_for_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintBottom_toTopOf="@id/track_artist"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="24dp"
                android:textSize="22sp"
                android:textColor="?attr/colorSecondary"
                tools:text="Yesterday (Remastered 2009)" />

            <TextView
                android:fontFamily="@font/ys_display_medium"
                android:id="@+id/track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                app:layout_constraintBottom_toTopOf="@id/view2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="30dp"
                android:textSize="14sp"
                android:textColor="?attr/colorSecondary"
                tools:text="The Beatles " />

            <ImageButton
                android:id="@+id/view1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="24dp"

                android:background="?attr/colorPrimaryVariant"
                android:src="@drawable/add_track"
                app:layout_constraintTop_toTopOf="@id/view2"
                app:layout_constraintBottom_toBottomOf="@id/view2"


                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
                android:id="@+id/view2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:src="@drawable/pause"
                android:layout_marginBottom="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:background="?attr/colorPrimaryVariant"
                app:layout_constraintBottom_toTopOf="@id/timer"

                />

            <ImageButton
                android:id="@+id/view3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginEnd="32dp"
                android:background="?attr/colorPrimaryVariant"

                android:src="@drawable/like"
                app:layout_constraintTop_toTopOf="@id/view2"
                app:layout_constraintBottom_toBottomOf="@id/view2"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView

                android:fontFamily="@font/ys_display_medium"
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="0:30"
                android:layout_marginBottom="30dp"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/duration"


                />
            <TextView
                android:id="@+id/country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="@string/Country"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="28dp"
                android:paddingTop="9dp"
                android:textColor="@color/gray"
                />
            <TextView
                android:id="@+id/genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/country"
                android:text="@string/genre"
                android:layout_marginStart="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:textColor="@color/gray"

                />
            <TextView
                android:id="@+id/year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/genre"
                android:text="@string/year"
                android:layout_marginStart="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:textColor="@color/gray"

                />
            <TextView
                android:id="@+id/album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/year"
                android:text="@string/album"
                android:layout_marginStart="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:textColor="@color/gray"

                />
            <TextView
                android:fontFamily="@font/ys_display_regular"
                android:id="@+id/duration"
                android:textColor="@color/gray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/album"
                android:text="@string/duration"
                android:layout_marginStart="16dp"
                android:paddingBottom="8dp"
                android:textSize="13sp"

                />
            <TextView
                android:fontFamily="@font/ys_display_regular"
                android:id="@+id/this_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="Великобритания"
                android:layout_marginBottom="28dp"
                android:paddingTop="9dp"
                android:layout_marginEnd="16dp"
                android:textSize="13sp"
                android:textColor="?attr/colorSecondary"

                />
            <TextView
                android:fontFamily="@font/ys_display_regular"
                android:id="@+id/this_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/this_country"
                tools:text="Rock"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="16dp"
                android:textSize="13sp"
                app:layout_constraintBaseline_toBaselineOf="@id/genre"
                android:textColor="?attr/colorSecondary"

                />
            <TextView
                android:fontFamily="@font/ys_display_regular"
                android:id="@+id/this_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/this_genre"
                tools:text="1965"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="16dp"
                android:textSize="13sp"
                android:textColor="?attr/colorSecondary"
                app:layout_constraintBaseline_toBaselineOf="@id/year"

                />
            <TextView

                android:fontFamily="@font/ys_display_regular"
                android:id="@+id/this_album"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/this_year"
                tools:text="Yesterday (Remastered )"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="end"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="16dp"
                android:textSize="13sp"
                app:layout_constraintStart_toEndOf="@id/album"
                android:textColor="?attr/colorSecondary"
                app:layout_constraintBaseline_toBaselineOf="@id/album"

                />
            <TextView
                android:fontFamily="@font/ys_display_regular"
                android:id="@+id/this_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/this_album"
                tools:text="5:35"
                app:layout_constraintBaseline_toBaselineOf="@id/duration"
                android:paddingBottom="8dp"
                android:layout_marginEnd="16dp"
                android:textSize="13sp"
                android:textColor="?attr/colorSecondary"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>





</androidx.constraintlayout.widget.ConstraintLayout>