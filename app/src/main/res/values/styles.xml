<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ButtonViewMain">

        <item name="android:textAllCaps">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:layout_marginHorizontal">15sp</item>
        <item name="android:layout_marginVertical">7sp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">@dimen/padding</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/textMainSize</item>
        <item name="android:elevation">20dp</item>
        <item name="android:shadowColor">@color/black</item>

    </style>
    <style name="TextViewSettings">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:paddingVertical">21dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textSize">@dimen/textSize</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>
    <style name="ButtonViewSettings">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>