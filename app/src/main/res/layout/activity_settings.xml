<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.MyNewPlaylist"

    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorPrimaryVariant"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_weight="1">
            <Button
                android:fontFamily="@font/ys_display_medium"
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:text="@string/settings"
                android:textAllCaps="false"
                android:textColor="?attr/colorSecondary"
                android:textSize="22sp"
                android:background="@android:color/transparent"
                android:paddingTop="1dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:icon="@drawable/back"
                app:iconTint="?attr/colorSecondary"
                app:iconSize="45sp"
                />
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <androidx.appcompat.widget.SwitchCompat
                    android:fontFamily="@font/ys_display_medium"
                    android:id="@+id/switch1"
                    android:textAllCaps="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:gravity="start"
                    android:paddingVertical="21dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="15dp"
                    android:text="@string/light_theme"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="@dimen/textSize"
                    tools:ignore="RtlSymmetry" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/TextViewSettings"
                    android:text="@string/share_app"
                    tools:ignore="RtlSymmetry" />
                <Button
                    android:id="@+id/share"
                    style="@style/ButtonViewSettings"
                    android:contentDescription="@string/share_app"
                    app:icon="@drawable/share"
                    app:iconGravity="textEnd"
                    app:iconSize="30sp"
                    app:iconTint="?attr/colorSecondaryVariant" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <TextView
                    style="@style/TextViewSettings"
                    android:text="@string/support"
                    tools:ignore="RtlSymmetry" />
                <Button
                    android:id="@+id/support"
                    style="@style/ButtonViewSettings"
                    android:contentDescription="@string/support"
                    app:icon="@drawable/support"
                    app:iconGravity="textEnd"
                    app:iconSize="30sp"
                    app:iconTint="?attr/colorSecondaryVariant" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <TextView
                    style="@style/TextViewSettings"
                    android:text="@string/user_agreement"
                    tools:ignore="RtlSymmetry" />
                <Button
                    android:id="@+id/agreement"
                    style="@style/ButtonViewSettings"
                    android:contentDescription="@string/user_agreement"
                    app:icon="@drawable/vector2"
                    app:iconGravity="textEnd"
                    app:iconSize="20sp"
                    app:iconTint="?attr/colorSecondaryVariant" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>