<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchActivity"
    android:theme="@style/Theme.MyNewPlaylist">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="158dp">

        <Button
            android:id="@+id/back2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/ys_display_medium"
            android:paddingStart="8dp"
            android:paddingTop="14dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp"
            android:text="@string/search"
            android:textAllCaps="false"
            android:textColor="?attr/colorSecondary"
            android:textSize="22sp"
            app:icon="@drawable/back"
            app:iconSize="45sp"
            app:iconTint="?attr/colorSecondary" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/radius_layout"
            android:backgroundTint="?attr/colorOnSurface"

            >

            <EditText
                android:id="@+id/input_edittext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:drawableStart="@drawable/light_mode"
                android:drawablePadding="8dp"
                android:drawableTint="?attr/colorAccent"
                android:fontFamily="@font/ys_display_regular"
                android:hint="@string/search"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingHorizontal="11dp"
                android:paddingVertical="8.5dp"
                android:paddingStart="13dp"
                android:paddingEnd="40dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="?attr/colorAccent"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="16sp"
                app:icon="@drawable/light_mode"
                app:iconTint="@color/black" />

            <ImageView

                android:id="@+id/clearIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="end"
                android:layout_marginVertical="14dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/vector"
                android:visibility="gone"
                app:tint="?attr/colorAccent" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp" />

        <LinearLayout
            android:id="@+id/not_found"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image_not_found"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="102dp"
                android:src="@drawable/smile_not_found"

                />

            <TextView
                android:id="@+id/text_not_found"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="@string/not_found" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/not_internet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="102dp"
                android:src="@drawable/not_internet" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/ys_display_medium"
                android:gravity="center"
                android:text="@string/not_internet"
                android:textColor="?attr/colorSecondary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/update_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:backgroundTint="?attr/colorSecondary"
                android:fontFamily="@font/ys_display_medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="@string/update"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimaryVariant"
                app:cornerRadius="54dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>